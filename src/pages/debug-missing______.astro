---
import { getCollection, getEntries } from "astro:content";
import OS9Window from "../components/OS9Window.astro";
import { SingleTheme } from "../components/singleTheme";
import BaseLayout from "../layouts/BaseLayout.astro";

const themesByAuthor = (await getCollection("themes")).filter(
  (t) => !t.data.isAirtable,
);
---

<BaseLayout title={`debug`}>
  <OS9Window asElement="main" title={`debug`}>
    <div class="single-author-page">
      <h1 class="single-theme-title">Missing from Airtable</h1>
      <div class="themes-grid">
        {
          themesByAuthor
            .map((t) => t.data)
            .map(async (theme, index) => {
              const authors = (await getEntries(theme.authors)).map(
                (a) => a.data,
              );

              return <SingleTheme likes={0} theme={theme} authors={authors} />;
            })
        }
      </div>
    </div>
  </OS9Window>
</BaseLayout>
